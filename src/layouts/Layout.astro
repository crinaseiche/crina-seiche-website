---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ro';
  canonical?: string;
}

const {
  title = 'Crina Seiche - Web Developer',
  description = 'Web developer specializing in PHP, Laravel, and client communication. Building reliable solutions.',
  lang = 'en',
  canonical
} = Astro.props;

const isRomanian = lang === 'ro';
const otherLang = isRomanian ? 'en' : 'ro';
const baseUrl = 'https://crinaseiche.pages.dev';
const currentUrl = lang === 'ro' ? `${baseUrl}/ro/` : `${baseUrl}/`;
const otherUrl = lang === 'ro' ? `${baseUrl}/` : `${baseUrl}/ro/`;
const finalCanonical = canonical || currentUrl;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonical} />
    <link rel="alternate" hreflang={lang} href={currentUrl} />
    <link rel="alternate" hreflang={otherLang} href={otherUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot />

    <script>
      // Language switcher
      const langSwitch = document.querySelectorAll('[data-lang-switch]');
      langSwitch.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetLang = btn.getAttribute('data-lang-switch');
          const currentPath = window.location.pathname;
          let newPath;

          if (targetLang === 'ro') {
            // Switch to Romanian: prepend /ro/
            newPath = currentPath === '/' ? '/ro/' : '/ro' + currentPath;
          } else {
            // Switch to English: remove /ro/ prefix
            newPath = currentPath.replace(/^\/ro/, '') || '/';
          }

          window.location.href = newPath;
        });
      });
    </script>
  </body>
</html>
