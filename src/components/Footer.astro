---
interface Props {
  lang?: 'en' | 'ro';
}

const { lang = 'en' } = Astro.props;

const content = lang === 'ro' ? {
  navItems: [
    { href: '/ro/', label: 'Acasă' },
    { href: '/ro/#services', label: 'Servicii' },
    { href: '/ro/#work', label: 'Experiență' },
    { href: '/ro/#contact', label: 'Contact' },
  ],
  contactLabel: 'Contact',
  socialLabel: 'mă găsești pe',
  copyright: 'All rights reserved.',
} : {
  navItems: [
    { href: '/', label: 'Home' },
    { href: '/#services', label: 'Services' },
    { href: '/#work', label: 'Experience' },
    { href: '/#contact', label: 'Contact' },
  ],
  contactLabel: 'Contact',
  socialLabel: 'Follow me',
  copyright: 'All rights reserved.',
};
---

<footer class="bg-white border-t border-divider py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand Section -->
      <div class="flex items-center gap-3">
        <div class="text-5xl font-serif font-bold text-navy-text tracking-tighter leading-none">
          CS
        </div>
        <div class="flex flex-col">
          <div class="text-sm font-sans font-semibold text-navy-text leading-tight">
            CRINA SEICHE
          </div>
          <div class="text-xs font-sans font-normal text-text-tertiary leading-tight">
            SENIOR SOFTWARE ENGINEER
          </div>
        </div>
      </div>

      <!-- Navigation Menu -->
      <div class="flex flex-col space-y-3">
        {content.navItems.map((item) => (
          <a href={item.href} class="text-sm font-sans font-normal text-navy-text hover:text-accent transition-colors">
            {item.label}
          </a>
        ))}
      </div>

      <!-- Contact Section -->
      <div class="flex flex-col">
        <p class="text-xs font-semibold text-accent uppercase mb-4 tracking-widest">
          {content.contactLabel}
        </p>

        <!-- Email -->
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-4 h-4 text-navy-text" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          <a href="mailto:crina.seiche@gmail.com" class="text-sm font-sans font-normal text-navy-text hover:text-accent transition-colors">
            crina.seiche@gmail.com
          </a>
        </div>

        <!-- Phone -->
        <div class="flex items-center gap-2 mb-3">
          <svg class="w-4 h-4 text-navy-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
            <circle cx="12" cy="21" r="1"/>
          </svg>
          <a href="tel:+40744878670" class="text-sm font-sans font-normal text-navy-text hover:text-accent transition-colors">
            +40744878670
          </a>
        </div>

        <!-- Location -->
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-navy-text" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
          </svg>
          <p class="text-sm font-sans font-normal text-navy-text">
            {lang === 'en' ? 'Oradea, Romania · Remote' : 'Oradea, România · Remote'}
          </p>
        </div>
      </div>

      <!-- Social Section -->
      <div class="flex flex-col">
        <p class="text-xs font-semibold text-accent uppercase mb-4 tracking-widest">
          {content.socialLabel}
        </p>
        <div class="flex gap-3">
          <!-- Website -->
          <a href="https://crinaseiche.pages.dev/" target="_blank" rel="noopener noreferrer" class="text-navy-text hover:text-accent transition-colors" aria-label="Website">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </a>
          <!-- GitHub -->
          <a href="https://github.com/crinaseiche" target="_blank" rel="noopener noreferrer" class="text-navy-text hover:text-accent transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/crinaseiche/" target="_blank" rel="noopener noreferrer" class="text-navy-text hover:text-accent transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Copyright Bar -->
  <div class="border-t border-divider mt-12 pt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-sans font-normal text-text-tertiary">
        © {new Date().getFullYear()} Crina Seiche. {content.copyright}
      </p>
    </div>
  </div>
</footer>
