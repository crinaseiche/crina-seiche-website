---
import { Image } from 'astro:assets';
import portraitImg from '../assets/portrait-me.png';

interface Props {
  lang?: 'en' | 'ro';
}

const { lang = 'en' } = Astro.props;

const content = lang === 'ro' ? {
  greeting: 'Salut, eu sunt',
  name: 'Crina Seiche',
  title: 'Senior Software Engineer',
  description: 'Transform cerințele de afaceri în aplicații web, susținute de 15+ ani de experiență în software development.',
  primaryBtn: 'Vezi Experiența',
  secondaryBtn: 'Hai să vorbim',
  portraitAlt: 'Crina Seiche, Senior Software Engineer',
} : {
  greeting: 'Hello, I\'m',
  name: 'Crina Seiche',
  title: 'Senior Software Engineer',
  description: 'I turn business requirements into web applications, backed by 15+ years of software development experience.',
  primaryBtn: 'View Experience',
  secondaryBtn: 'Let\'s Talk',
  portraitAlt: 'Crina Seiche, Senior Software Engineer',
};
---

<section class="pt-24 md:pt-28 pb-4 md:pb-6 bg-white text-navy-text flex items-center relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-center">
      <!-- Left Column: Text -->
      <div class="flex flex-col justify-start">
        <!-- Greeting (small caps, gray) -->
        <p class="text-sm md:text-base font-sans font-medium text-text-tertiary mb-6 tracking-widest uppercase">
          {content.greeting}
        </p>

        <!-- Name (serif, large, bold) -->
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-serif font-bold text-navy-text mb-3 leading-tight">
          {content.name}
        </h1>

        <!-- Title (serif, accent color, italic style) -->
        <p class="text-4xl md:text-5xl font-serif font-normal text-accent italic mb-6">
          {content.title}
        </p>

        <!-- Separator -->
        <div class="w-12 h-0.5 bg-navy-text mb-6"></div>

        <!-- Description -->
        <p class="text-base md:text-base text-text-secondary mb-10 leading-relaxed max-w-lg">
          {content.description}
        </p>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href={`#work`} class="btn btn-primary text-center sm:text-left">
            {content.primaryBtn} →
          </a>
          <a href={`#contact`} class="btn btn-secondary text-center sm:text-left">
            {content.secondaryBtn}
          </a>
        </div>

      </div>

      <!-- Right Column: Portrait -->
      <div class="hidden md:flex flex-col items-center justify-center relative h-full">
        <div class="relative w-full max-w-sm">
          <!-- Portrait -->
          <div class="rounded-lg overflow-hidden">
            <Image
              src={portraitImg}
              alt={content.portraitAlt}
              class="w-full h-auto object-cover"
              loading="eager"
              quality={85}
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Portrait -->
    <div class="md:hidden mt-12 relative max-w-sm mx-auto">
      <div class="rounded-lg overflow-hidden">
        <Image
          src={portraitImg}
          alt={content.portraitAlt}
          class="w-full h-auto object-cover"
          loading="eager"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
